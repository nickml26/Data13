  <script>
    (() => {
      const picker = document.getElementById("file-input");
      const zone = document.getElementById("drop-zone");
      const empty = document.getElementById("empty-state");
      const preview = document.getElementById("jpeg-preview");
      const quality = document.getElementById("quality");
      const output = document.getElementById("quality-output");
      const download = document.getElementById("download");
      const remove = document.getElementById("remove");
      const status = document.getElementById("status");
      const nameField = document.getElementById("detail-name");
      const dimensionsField = document.getElementById("detail-dimensions");
      const sizeField = document.getElementById("detail-size");
      const uploadLabel = document.querySelector('label[for="file-input"]');
      let sourceCanvas = null, sourceName = "", jpegBlob = null, jpegUrl = null, generation = 0, debounce = null, dragDepth = 0;

      function message(text, error = false) {
        status.textContent = text;
        status.style.color = error ? "#ad3827" : "#67747a";
      }
      function releaseJpeg() {
        if (jpegUrl) URL.revokeObjectURL(jpegUrl);
        jpegUrl = null;
        jpegBlob = null;
      }
      function formatSize(bytes) {
        return bytes < 1024 * 1024 ? (bytes / 1024).toFixed(1) + " KB" : (bytes / (1024 * 1024)).toFixed(2) + " MB";
      }
      function clearImage() {
        generation++;
        clearTimeout(debounce);
        releaseJpeg();
        sourceCanvas = null;
        sourceName = "";
        picker.value = "";
        quality.value = "85";
        output.value = "85%";
        preview.removeAttribute("src");
        preview.classList.add("hidden");
        empty.classList.remove("hidden");
        nameField.textContent = "—";
        dimensionsField.textContent = "—";
        sizeField.textContent = "—";
        quality.disabled = true;
        download.disabled = true;
        remove.disabled = true;
        message("");
      }
      function encode() {
        if (!sourceCanvas) return;
        const thisGeneration = ++generation;
        download.disabled = true;
        message("Preparing JPEG preview…");
        sourceCanvas.toBlob(blob => {
          if (thisGeneration !== generation) return;
          if (!blob || blob.type !== "image/jpeg") {
            message("This image could not be converted to JPEG. Please try another image.", true);
            return;
          }
          releaseJpeg();
          jpegBlob = blob;
          jpegUrl = URL.createObjectURL(blob);
          preview.src = jpegUrl;
          preview.classList.remove("hidden");
          empty.classList.add("hidden");
          sizeField.textContent = formatSize(blob.size);
          download.disabled = false;
          message("JPEG preview ready to download.");
        }, "image/jpeg", Number(quality.value) / 100);
      }
      async function loadFile(file) {
        if (!file) return;
        if (!file.type.startsWith("image/")) {
          message("Please choose an image file.", true);
          return;
        }
        if (file.size === 0) {
          message("This image file is empty. Choose another image.", true);
          return;
        }
        const thisGeneration = ++generation;
        clearTimeout(debounce);
        message("Opening image…");
        let bitmap;
        try {
          bitmap = await createImageBitmap(file, { imageOrientation: "from-image" });
          if (thisGeneration !== generation) { bitmap.close(); return; }
          if (!bitmap.width || !bitmap.height) throw new Error("Invalid dimensions");
          const canvas = document.createElement("canvas");
          canvas.width = bitmap.width;
          canvas.height = bitmap.height;
          const ctx = canvas.getContext("2d");
          if (!ctx) throw new Error("Canvas unavailable");
          ctx.fillStyle = "#ffffff";
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(bitmap, 0, 0);
          bitmap.close();
          sourceCanvas = canvas;
          sourceName = file.name;
          nameField.textContent = file.name;
          dimensionsField.textContent = canvas.width.toLocaleString() + " × " + canvas.height.toLocaleString() + " px";
          quality.disabled = false;
          remove.disabled = false;
          encode();
        } catch (_) {
          if (bitmap) bitmap.close();
          if (thisGeneration === generation) message("This image could not be opened. Try a different image format or file.", true);
        }
      }

      picker.addEventListener("change", () => loadFile(picker.files[0]));
      uploadLabel.addEventListener("keydown", event => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          picker.click();
        }
      });
      zone.addEventListener("dragenter", event => {
        event.preventDefault();
        dragDepth++;
        zone.classList.add("drop-active");
      });
      zone.addEventListener("dragover", event => {
        event.preventDefault();
        event.dataTransfer.dropEffect = "copy";
      });
      zone.addEventListener("dragleave", event => {
        event.preventDefault();
        dragDepth = Math.max(0, dragDepth - 1);
        if (!dragDepth) zone.classList.remove("drop-active");
      });
      zone.addEventListener("drop", event => {
        event.preventDefault();
        dragDepth = 0;
        zone.classList.remove("drop-active");
        loadFile(event.dataTransfer.files[0]);
      });
      quality.addEventListener("input", () => {
        output.value = quality.value + "%";
        if (!sourceCanvas) return;
        generation++;
        download.disabled = true;
        message("Updating JPEG preview…");
        clearTimeout(debounce);
        debounce = setTimeout(encode, 180);
      });
      download.addEventListener("click", () => {
        if (!jpegBlob || !jpegUrl) return;
        const link = document.createElement("a");
        link.href = jpegUrl;
        link.download = (sourceName.replace(/\.[^.]+$/, "") || "picture") + ".jpg";
        document.body.appendChild(link);
        link.click();
        link.remove();
        message("Your JPEG download has started.");
      });
      remove.addEventListener("click", clearImage);
      window.addEventListener("pagehide", releaseJpeg);
    })();
  </script>
 
